{
  "name": "crucible",
  "private": true,
  "version": "0.1.0",
  "description": "Crucible: an open-core, all-in-one AI engineering platform. Prompts, evals, traces, agent replay, model gateway, RAG pipelines and agent operations in one local-first tool.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' --filter './apps/*' run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "dev": "pnpm --filter @crucible/server run dev",
    "lint": "pnpm -r run lint"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "tsx": "^4.19.0",
    "vitest": "^5.1.0"
  }
}
